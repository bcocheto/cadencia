<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.cadencia" path="/org/gnome/shell/extensions/cadencia/">
    <key name="panel-position" type="s">
      <choices>
        <choice value="left"/>
        <choice value="center"/>
        <choice value="right"/>
      </choices>
      <default>"right"</default>
      <summary>Posição na barra</summary>
    </key>
    <key name="show-title" type="b">
      <default>true</default>
      <summary>Mostrar título da faixa na barra</summary>
    </key>
    <key name="max-title-width" type="i">
      <range min="80" max="600"/>
      <default>220</default>
      <summary>Largura máxima do título na barra (px)</summary>
    </key>
    <key name="hide-when-idle" type="b">
      <default>true</default>
      <summary>Esconder o indicador quando não há player</summary>
    </key>
    <key name="left-click-action" type="s">
      <choices>
        <choice value="menu"/>
        <choice value="play-pause"/>
        <choice value="next"/>
        <choice value="previous"/>
        <choice value="raise"/>
        <choice value="none"/>
      </choices>
      <default>"menu"</default>
      <summary>Ação do clique esquerdo no indicador</summary>
    </key>
    <key name="middle-click-action" type="s">
      <choices>
        <choice value="menu"/>
        <choice value="play-pause"/>
        <choice value="next"/>
        <choice value="previous"/>
        <choice value="raise"/>
        <choice value="none"/>
      </choices>
      <default>"play-pause"</default>
      <summary>Ação do clique do meio no indicador</summary>
    </key>
    <key name="right-click-action" type="s">
      <choices>
        <choice value="menu"/>
        <choice value="play-pause"/>
        <choice value="next"/>
        <choice value="previous"/>
        <choice value="raise"/>
        <choice value="none"/>
      </choices>
      <default>"menu"</default>
      <summary>Ação do clique direito no indicador</summary>
    </key>
    <key name="scroll-action" type="s">
      <choices>
        <choice value="volume"/>
        <choice value="seek"/>
        <choice value="track"/>
        <choice value="none"/>
      </choices>
      <default>"volume"</default>
      <summary>Ação de rolar o mouse sobre o indicador</summary>
    </key>
    <key name="seek-step" type="i">
      <range min="1" max="60"/>
      <default>5</default>
      <summary>Passo do avanço ao rolar (segundos)</summary>
    </key>
    <key name="scroll-title" type="b">
      <default>false</default>
      <summary>Rolar o texto da barra quando ele não cabe</summary>
    </key>
    <key name="volume-step" type="i">
      <range min="1" max="25"/>
      <default>5</default>
      <summary>Passo do volume (%)</summary>
    </key>
    <key name="show-artist" type="b">
      <default>true</default>
      <summary>Mostrar o artista na barra</summary>
    </key>
    <key name="show-album" type="b">
      <default>false</default>
      <summary>Mostrar o álbum na barra</summary>
    </key>
    <key name="separator" type="s">
      <default>" — "</default>
      <summary>Separador entre título, artista e álbum na barra</summary>
    </key>
    <key name="use-app-icon" type="b">
      <default>false</default>
      <summary>Usar o ícone do aplicativo na barra, em vez do ícone de estado</summary>
    </key>
    <key name="accent-source" type="s">
      <choices>
        <choice value="system"/>
        <choice value="cover"/>
      </choices>
      <default>"system"</default>
      <summary>Origem da cor de destaque: cor de destaque do sistema ou cor dominante da capa</summary>
    </key>
    <key name="cover-layout" type="b">
      <default>false</default>
      <summary>Popup com a capa em destaque</summary>
    </key>
    <key name="blocked-players" type="as">
      <default>[]</default>
      <summary>Players ignorados (nome do serviço MPRIS, sem prefixo e sem instância)</summary>
    </key>
  </schema>
</schemalist>
